// Prisma schema for the poultry house monitoring system.
// All timestamps are stored in UTC (timestamptz).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  irrigation_on
  irrigation_off
  heat_alert_no_irrigation
  prolonged_irrigation_alert
  sensor_error

  @@map("event_type")
}

model Device {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @db.VarChar(100)
  shed       String    @db.VarChar(100)
  apiKeyHash String    @unique @map("api_key_hash") @db.Char(64)
  active     Boolean   @default(true)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  settings DeviceSettings?
  readings Reading[]
  events   Event[]
  alerts   Alert[]

  @@map("devices")
}

model Reading {
  id          String   @id @default(uuid(7)) @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  temperature Decimal  @db.Decimal(5, 2)
  humidity    Decimal? @db.Decimal(5, 2)
  irrigation  Boolean
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("readings")
}

model Event {
  id          String    @id @default(uuid(7)) @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  type        EventType
  temperature Decimal?  @db.Decimal(5, 2)
  durationMin Decimal?  @map("duration_min") @db.Decimal(8, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("events")
}

model DeviceSettings {
  id        String  @id @default(uuid(7)) @db.Uuid
  deviceId  String  @unique @map("device_id") @db.Uuid
  tempMin   Decimal @default(27) @map("temp_min") @db.Decimal(5, 2)
  tempMax   Decimal @default(30) @map("temp_max") @db.Decimal(5, 2)
  tempAlert Decimal @default(32) @map("temp_alert") @db.Decimal(5, 2)

  /// Alert rules (minutes).
  offlineAfterMin  Int @default(5) @map("offline_after_min")
  sustainedHeatMin Int @default(10) @map("sustained_heat_min")
  sustainedColdMin Int @default(30) @map("sustained_cold_min")
  reminderEveryMin Int @default(30) @map("reminder_every_min")
  escalateAfterMin Int @default(15) @map("escalate_after_min")

  /// Irrigation rules. Off when the shed has no irrigation detector wired
  /// (the ESP32 then always reports irrigation: false).
  irrigationSensor       Boolean @default(true) @map("irrigation_sensor")
  heatNoIrrigationMin    Int     @default(5) @map("heat_no_irrigation_min")
  prolongedIrrigationMin Int     @default(30) @map("prolonged_irrigation_min")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_settings")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable identifier used in code for system roles (admin, supervisor, viewer).
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  /// Permission keys (see src/auth/permissions.ts).
  permissions String[]
  /// System roles cannot be deleted; the admin role cannot be edited.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Always stored in lowercase.
  email              String    @unique @db.VarChar(255)
  name               String    @db.VarChar(100)
  passwordHash       String    @map("password_hash")
  roleId             String    @map("role_id") @db.Uuid
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role               Role                     @relation(fields: [roleId], references: [id])
  sessions           Session[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  acknowledgedAlerts Alert[]                  @relation("AlertAcknowledgedBy")
  resolvedAlerts     Alert[]                  @relation("AlertResolvedBy")
  channels           NotificationChannel[]    @relation("ChannelOwner")
  linkedGroups       NotificationChannel[]    @relation("ChannelLinkedBy")
  linkCodes          ChannelLinkCode[]
  notificationPrefs  NotificationPreferences?

  @@index([roleId])
  @@map("users")
}

/// Refresh-token session. Only the SHA-256 hash of the token is stored.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  /// Token replaced by the last rotation; still accepted for a short grace
  /// period in case the response carrying the new one never reached the browser.
  previousTokenHash String?   @unique @map("previous_token_hash") @db.Char(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ip                String?   @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions not tied to a user (e.g. a failed login).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Alerts and notifications
// ---------------------------------------------------------------------------

enum AlertKind {
  heat_no_irrigation
  prolonged_irrigation
  sensor_error
  device_offline
  sustained_heat
  sustained_cold

  @@map("alert_kind")
}

enum AlertSeverity {
  critical
  warning

  @@map("alert_severity")
}

enum AlertStatus {
  open
  acknowledged
  resolved

  @@map("alert_status")
}

/// An incident: opened once, reminded while nobody attends it, resolved once.
/// At most one unresolved alert per (device, kind): see the partial unique
/// index in the migration.
model Alert {
  id                 String        @id @default(uuid(7)) @db.Uuid
  deviceId           String        @map("device_id") @db.Uuid
  kind               AlertKind
  severity           AlertSeverity
  status             AlertStatus   @default(open)
  openedAt           DateTime      @default(now()) @map("opened_at") @db.Timestamptz(3)
  triggerTemperature Decimal?      @map("trigger_temperature") @db.Decimal(5, 2)
  peakTemperature    Decimal?      @map("peak_temperature") @db.Decimal(5, 2)
  acknowledgedAt     DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  acknowledgedById   String?       @map("acknowledged_by_id") @db.Uuid
  resolvedAt         DateTime?     @map("resolved_at") @db.Timestamptz(3)
  resolvedById       String?       @map("resolved_by_id") @db.Uuid
  /// Why it closed, in Spanish (e.g. "Se encendió el riego").
  resolution         String?       @db.VarChar(255)
  lastNotifiedAt     DateTime      @default(now()) @map("last_notified_at") @db.Timestamptz(3)
  reminderCount      Int           @default(0) @map("reminder_count")
  escalatedAt        DateTime?     @map("escalated_at") @db.Timestamptz(3)
  metadata           Json?

  device         Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  acknowledgedBy User?          @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     User?          @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  notifications  Notification[]

  @@index([status, openedAt])
  @@index([deviceId, openedAt])
  @@map("alerts")
}

enum NotificationKind {
  alert_opened
  alert_reminder
  alert_escalated
  alert_resolved
  daily_summary
  test

  @@map("notification_kind")
}

/// One entry in a user's inbox. Channel deliveries (Telegram, WhatsApp) hang off it.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  alertId   String?          @map("alert_id") @db.Uuid
  kind      NotificationKind
  severity  AlertSeverity?
  title     String           @db.VarChar(160)
  body      String           @db.VarChar(1000)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert      Alert?                 @relation(fields: [alertId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

enum ChannelType {
  telegram
  whatsapp

  @@map("channel_type")
}

enum DeliveryStatus {
  pending
  sent
  failed
  skipped

  @@map("delivery_status")
}

/// Where a person (or the farm's Telegram group) receives notifications outside the dashboard.
model NotificationChannel {
  id            String      @id @default(uuid(7)) @db.Uuid
  /// Null for a group chat: groups belong to the farm, not to one person.
  userId        String?     @map("user_id") @db.Uuid
  type          ChannelType
  /// Telegram chat id, or WhatsApp number in E.164 (+50255551234).
  address       String      @db.VarChar(64)
  /// "@usuario", group title or masked phone, for display.
  label         String?     @db.VarChar(120)
  isGroup       Boolean     @default(false) @map("is_group")
  active        Boolean     @default(true)
  /// Last message received from this chat (WhatsApp only lets us write within 24 h).
  lastInboundAt DateTime?   @map("last_inbound_at") @db.Timestamptz(3)
  linkedById    String?     @map("linked_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User?                  @relation("ChannelOwner", fields: [userId], references: [id], onDelete: Cascade)
  linkedBy   User?                  @relation("ChannelLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)
  deliveries NotificationDelivery[]

  @@unique([type, address])
  @@index([userId])
  @@map("notification_channels")
}

/// One-time code that proves a chat or phone belongs to the user who asked for it.
model ChannelLinkCode {
  code      String      @id @db.VarChar(16)
  userId    String      @map("user_id") @db.Uuid
  type      ChannelType
  isGroup   Boolean     @default(false) @map("is_group")
  /// WhatsApp number the code was issued for.
  address   String?     @db.VarChar(64)
  expiresAt DateTime    @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("channel_link_codes")
}

model NotificationPreferences {
  userId          String   @id @map("user_id") @db.Uuid
  telegram        Boolean  @default(true)
  whatsapp        Boolean  @default(true)
  /// False: only critical alerts reach Telegram and WhatsApp.
  includeWarnings Boolean  @default(true) @map("include_warnings")
  /// "22:00". During quiet hours only critical alerts go out.
  quietStart      String?  @map("quiet_start") @db.VarChar(5)
  quietEnd        String?  @map("quiet_end") @db.VarChar(5)
  dailySummary    Boolean  @default(true) @map("daily_summary")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Outbox: one message to one channel, retried until it is sent or gives up.
model NotificationDelivery {
  id                String           @id @default(uuid(7)) @db.Uuid
  channelId         String           @map("channel_id") @db.Uuid
  notificationId    String?          @map("notification_id") @db.Uuid
  alertId           String?          @map("alert_id") @db.Uuid
  deviceId          String?          @map("device_id") @db.Uuid
  kind              NotificationKind
  severity          AlertSeverity?
  title             String           @db.VarChar(160)
  body              String           @db.VarChar(1000)
  /// Extra content built at send time, e.g. { "type": "daily_report", "date": "2026-10-19" }.
  attachment        Json?
  status            DeliveryStatus   @default(pending)
  attempts          Int              @default(0)
  nextAttemptAt     DateTime         @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError         String?          @map("last_error") @db.VarChar(500)
  providerMessageId String?          @map("provider_message_id") @db.VarChar(120)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  channel      NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  notification Notification?       @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([channelId, createdAt])
  @@index([createdAt])
  @@map("notification_deliveries")
}
