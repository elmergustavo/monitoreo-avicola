// Prisma schema for the poultry house monitoring system.
// All timestamps are stored in UTC (timestamptz).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  irrigation_on
  irrigation_off
  heat_alert_no_irrigation
  prolonged_irrigation_alert
  sensor_error

  @@map("event_type")
}

model Device {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @db.VarChar(100)
  shed       String    @db.VarChar(100)
  apiKeyHash String    @unique @map("api_key_hash") @db.Char(64)
  active     Boolean   @default(true)
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  settings DeviceSettings?
  readings Reading[]
  events   Event[]

  @@map("devices")
}

model Reading {
  id          String   @id @default(uuid(7)) @db.Uuid
  deviceId    String   @map("device_id") @db.Uuid
  temperature Decimal  @db.Decimal(5, 2)
  humidity    Decimal? @db.Decimal(5, 2)
  irrigation  Boolean
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("readings")
}

model Event {
  id          String    @id @default(uuid(7)) @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  type        EventType
  temperature Decimal?  @db.Decimal(5, 2)
  durationMin Decimal?  @map("duration_min") @db.Decimal(8, 2)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("events")
}

model DeviceSettings {
  id        String   @id @default(uuid(7)) @db.Uuid
  deviceId  String   @unique @map("device_id") @db.Uuid
  tempMin   Decimal  @default(27) @map("temp_min") @db.Decimal(5, 2)
  tempMax   Decimal  @default(30) @map("temp_max") @db.Decimal(5, 2)
  tempAlert Decimal  @default(32) @map("temp_alert") @db.Decimal(5, 2)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_settings")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Stable identifier used in code for system roles (admin, supervisor, viewer).
  key         String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  /// Permission keys (see src/auth/permissions.ts).
  permissions String[]
  /// System roles cannot be deleted; the admin role cannot be edited.
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  /// Always stored in lowercase.
  email              String    @unique @db.VarChar(255)
  name               String    @db.VarChar(100)
  passwordHash       String    @map("password_hash")
  roleId             String    @map("role_id") @db.Uuid
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  role      Role       @relation(fields: [roleId], references: [id])
  sessions  Session[]
  auditLogs AuditLog[]

  @@index([roleId])
  @@map("users")
}

/// Refresh-token session. Only the SHA-256 hash of the token is stored.
model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  /// Token replaced by the last rotation; still accepted for a short grace
  /// period in case the response carrying the new one never reached the browser.
  previousTokenHash String?   @unique @map("previous_token_hash") @db.Char(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  userAgent         String?   @map("user_agent") @db.VarChar(255)
  ip                String?   @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null for actions not tied to a user (e.g. a failed login).
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(100)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
