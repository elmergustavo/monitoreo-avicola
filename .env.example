# ---------------------------------------------------------------
# Local environment. Copy to .env:  cp .env.example .env
# Used by docker-compose.yml and by the API (backend/) when it runs
# on your machine with `npm run start:dev`.
# ---------------------------------------------------------------

# PostgreSQL (docker-compose)
POSTGRES_USER=avicola
POSTGRES_PASSWORD=avicola_dev
POSTGRES_DB=monitoreo_avicola
POSTGRES_PORT=5432

# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://avicola:avicola_dev@localhost:5432/monitoreo_avicola?schema=public

# Comma-separated list of allowed origins for the dashboard, or * for any.
CORS_ORIGINS=http://localhost:5180

# Rate limiting: max requests per IP within the time window.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Set to true when the API runs behind a reverse proxy (Dokploy / Traefik).
TRUST_PROXY=false

# Enable Swagger UI at /api/docs.
SWAGGER_ENABLED=true

# Authentication. Generate the secret with: openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# First administrator, created by the seed if it does not exist.
# If ADMIN_PASSWORD is empty, a temporary password is generated and printed.
ADMIN_EMAIL=admin@lasierra.local
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# API key for the "Galpón 1" device created by the seed.
# Generate a new one with: openssl rand -hex 32
SEED_DEVICE_API_KEY=change-me-generate-with-openssl-rand-hex-32

# ---------------------------------------------------------------
# Notifications outside the dashboard (optional: leave empty to keep them off)
# ---------------------------------------------------------------

# Public dashboard address for "Ver galpón" links (https only; Telegram rejects localhost).
DASHBOARD_URL=

# Telegram: create a bot with @BotFather and paste its token.
# Locally use polling (no public URL needed). In production use webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_URL=
# openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp through Twilio (sandbox for the demo).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The "join <words>" phrase shown in the Twilio sandbox console.
TWILIO_SANDBOX_JOIN_CODE=
# Public URL of /api/whatsapp/webhook exactly as set in Twilio (needs a tunnel locally).
TWILIO_WEBHOOK_URL=
